CONFIG_KSU=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y
# Concrete SUSFS feature set.  SUS_MOUNT / OPEN_REDIRECT / SUS_MAP stay off
# until their VFS hooks are ported against this vendor tree (docs/susfs.md).
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
# CONFIG_KSU_SUSFS_SUS_MOUNT is not set
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
# CONFIG_KSU_SUSFS_SUS_MAP is not set
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_OPLUS_ROOT_CHECK is not set
# CONFIG_OPLUS_MOUNT_BLOCK is not set
# CONFIG_OPLUS_EXECVE_BLOCK is not set
