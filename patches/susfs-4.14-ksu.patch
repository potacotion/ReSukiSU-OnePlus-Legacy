diff --git a/fs/namei.c b/fs/namei.c
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -2588,6 +2588,20 @@ static int filename_lookup(int dfd, struct filename *name, unsigned flags,
 	return retval;
 }
 
+#ifdef CONFIG_KSU_SUSFS
+/*
+ * KernelSU's SUSFS (susfs_inline) sucompat handlers rewrite the name inside a
+ * struct filename, so fs/open.c and fs/stat.c have to resolve a name they
+ * obtained themselves. filename_lookup() is private to this file and owns the
+ * putname(), so expose it as a drop-in replacement for user_path_at().
+ */
+int ksu_susfs_filename_lookup(int dfd, struct filename *name, unsigned flags,
+			      struct path *path)
+{
+	return filename_lookup(dfd, name, flags, path, NULL);
+}
+#endif
