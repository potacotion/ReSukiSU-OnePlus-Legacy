diff --git a/fs/stat.c b/fs/stat.c
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -18,10 +18,25 @@
 #include <linux/pagemap.h>
 #include <linux/compat.h>
 #ifdef CONFIG_KSU_SUSFS
+#include <linux/jump_label.h>
 #include <linux/susfs_def.h>
 #include <linux/version.h>
 #endif
 
+#ifdef CONFIG_KSU_SUSFS
+/*
+ * Inline hooks required by KernelSU's SUSFS (susfs_inline) build. Both
+ * sucompat handlers take a struct filename, so they must run between
+ * getname_flags() and the lookup: the raw user pointer would be dereferenced
+ * as a kernel structure.
+ */
+extern struct static_key_true ksu_is_init_rc_hook_enabled;
+extern void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr);
+extern struct static_key_true ksu_su_compat_enabled;
+extern bool __ksu_is_allow_uid_for_current(uid_t uid);
+extern int ksu_handle_stat(int *dfd, struct filename **filename, int *flags);
+#endif
+
 #include <linux/uaccess.h>
 #include <asm/unistd.h>
 
@@ -162,6 +177,11 @@ int vfs_statx_fd(unsigned int fd, struct kstat *stat,
 	if (f.file) {
 		error = vfs_getattr(&f.file->f_path, stat,
 				    request_mask, query_flags);
+#ifdef CONFIG_KSU_SUSFS
+		if (!error &&
+		    static_branch_unlikely(&ksu_is_init_rc_hook_enabled))
+			ksu_handle_vfs_fstat(fd, &stat->size);
+#endif
 		fdput(f);
 	}
 	return error;
@@ -189,6 +209,9 @@ int vfs_statx(int dfd, const char __user *filename, int flags,
 	struct path path;
 	int error = -EINVAL;
 	unsigned int lookup_flags = LOOKUP_FOLLOW | LOOKUP_AUTOMOUNT;
+#ifdef CONFIG_KSU_SUSFS
+	struct filename *ksu_filename;
+#endif
 
 	if ((flags & ~(AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT |
 		       AT_EMPTY_PATH | KSTAT_QUERY_FLAGS)) != 0)
@@ -202,7 +225,19 @@ int vfs_statx(int dfd, const char __user *filename, int flags,
 		lookup_flags |= LOOKUP_EMPTY;
 
 retry:
+#ifdef CONFIG_KSU_SUSFS
+	/* Same ordering as faccessat: the sucompat stat handler rewrites
+	 * (*filename)->name in place, so it needs the struct filename that the
+	 * upcoming lookup will consume. */
+	ksu_filename = getname_flags(filename, lookup_flags, NULL);
+	if (!susfs_is_current_proc_no_su() && !IS_ERR(ksu_filename) &&
+	    static_branch_likely(&ksu_su_compat_enabled) &&
+	    unlikely(__ksu_is_allow_uid_for_current(current_uid().val)))
+		ksu_handle_stat(&dfd, &ksu_filename, &flags);
+	error = ksu_susfs_filename_lookup(dfd, ksu_filename, lookup_flags, &path);
+#else
 	error = user_path_at(dfd, filename, lookup_flags, &path);
+#endif
 	if (error)
 		goto out;
 
