 #include "internal.h"
 
@@ -363,6 +368,11 @@ SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 {
 #ifdef CONFIG_KSU_MANUAL_HOOK
 extern int ksu_handle_faccessat(int *, const char __user **, int *, int *);
+#endif
+#ifdef CONFIG_KSU_SUSFS
+extern int ksu_handle_faccessat(int *, struct filename **, int *, int *);
+extern struct static_key_true ksu_su_compat_enabled;
+extern bool __ksu_is_allow_uid_for_current(uid_t uid);
 #endif
 	const struct cred *old_cred;
 	struct cred *override_cred;
@@ -371,6 +381,9 @@ extern int ksu_handle_faccessat(int *, const char __user **, int *, int *);
 	struct vfsmount *mnt;
 	int res;
 	unsigned int lookup_flags = LOOKUP_FOLLOW;
+#ifdef CONFIG_KSU_SUSFS
+	struct filename *ksu_filename;
+#endif
 
 #ifdef CONFIG_KSU_MANUAL_HOOK
 	ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
@@ -416,7 +429,24 @@ extern int ksu_handle_faccessat(int *, const char __user **, int *, int *);
 
 	old_cred = override_creds(override_cred);
 retry:
+#ifdef CONFIG_KSU_SUSFS
+	/*
+	 * The SUSFS build of KernelSU's sucompat handler rewrites the resolved
+	 * name of a struct filename in place, so it has to run after
+	 * getname_flags() materialised one. Handing it the raw user pointer
+	 * would make it read user memory as a kernel structure and crash.
+	 * filename_lookup() consumes (putname()) the name it is given, which
+	 * makes this sequence identical to user_path_at() otherwise.
+	 */
+	ksu_filename = getname_flags(filename, lookup_flags, NULL);
+	if (!susfs_is_current_proc_no_su() && !IS_ERR(ksu_filename) &&
+	    static_branch_likely(&ksu_su_compat_enabled) &&
+	    unlikely(__ksu_is_allow_uid_for_current(current_uid().val)))
+		ksu_handle_faccessat(&dfd, &ksu_filename, &mode, NULL);
+	res = ksu_susfs_filename_lookup(dfd, ksu_filename, lookup_flags, &path);
+#else
 	res = user_path_at(dfd, filename, lookup_flags, &path);
+#endif
 	if (res)
 		goto out;
 
